<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#FFD1DC"/>
      <stop offset="50%" stop-color="#BEE3F8"/>
      <stop offset="100%" stop-color="#EBF8FF"/>
    </linearGradient>
    <pattern id="heartPattern" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 20 15 C 16 10 10 12 10 18 C 10 24 20 30 20 30 C 20 30 30 24 30 18 C 30 12 24 10 20 15 Z" fill="#FF8EAC" opacity="0.2"/>
    </pattern>
  </defs>

  <rect width="500" height="500" rx="20" fill="url(#bgGrad)"/>
  <rect width="500" height="500" rx="20" fill="url(#heartPattern)"/>

  <!-- Decorative Frame -->
  <rect x="25" y="25" width="450" height="450" rx="15" fill="none" stroke="#FFFFFF" stroke-width="8" stroke-dasharray="16 10"/>

  <!-- Center Birthday Star / Illustration -->
  <g transform="translate(250, 210)">
    <!-- Crown -->
    <path d="M -40 -90 L -20 -115 L 0 -85 L 20 -115 L 40 -90 L 30 -65 L -30 -65 Z" fill="#FFD166" stroke="#2B2D42" stroke-width="3"/>
    <circle cx="-20" cy="-115" r="5" fill="#FF477E"/>
    <circle cx="0" cy="-85" r="5" fill="#4EA8DE"/>
    <circle cx="20" cy="-115" r="5" fill="#FF477E"/>

    <!-- Happy Birthday Girl Avatar -->
    <circle cx="0" cy="-20" r="60" fill="#FFE0BD" stroke="#2B2D42" stroke-width="4"/>
    <!-- Cute Hair -->
    <path d="M -60 -20 C -65 -80 65 -80 60 -20 C 50 -40 -50 -40 -60 -20 Z" fill="#6C5CE7"/>
    <path d="M -62 -10 C -75 40 -50 80 -45 50 M 62 -10 C 75 40 50 80 45 50" fill="none" stroke="#6C5CE7" stroke-width="14" stroke-linecap="round"/>

    <!-- Eyes closed smiling -->
    <path d="M -25 -20 Q -15 -32 -5 -20" fill="none" stroke="#2B2D42" stroke-width="4" stroke-linecap="round"/>
    <path d="M 5 -20 Q 15 -32 25 -20" fill="none" stroke="#2B2D42" stroke-width="4" stroke-linecap="round"/>

    <!-- Cheeks & Smile -->
    <ellipse cx="-25" cy="-8" rx="8" ry="5" fill="#FF8EAC" opacity="0.8"/>
    <ellipse cx="25" cy="-8" rx="8" ry="5" fill="#FF8EAC" opacity="0.8"/>
    <path d="M -10 -5 Q 0 10 10 -5" fill="none" stroke="#2B2D42" stroke-width="3.5" stroke-linecap="round"/>

    <!-- Birthday Sparkles -->
    <text x="0" y="110" font-family="'Fredoka', 'Quicksand', sans-serif" font-size="28" font-weight="bold" fill="#2B2D42" text-anchor="middle">
      ✨ Birthday Girl ✨
    </text>
    <text x="0" y="140" font-family="'Quicksand', sans-serif" font-size="16" fill="#6C5CE7" text-anchor="middle">
      (Click or Drag &amp; Drop to Replace with Your Photo!)
    </text>
  </g>
</svg>
